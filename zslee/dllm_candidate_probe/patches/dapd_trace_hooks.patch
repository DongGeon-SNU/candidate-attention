+                        "accepted": bool(can_select),
+                        "decisive_blocker_position": (
+                            None if decisive_blocker is None else int(decisive_blocker)
+                        ),
+                        "normalized_dependency_score": decisive_normalized_score,
+                        "raw_attention_dependency_score": decisive_raw_score,
+                        "edge_threshold": float(tau),
+                        "combined_selection_score": float(combined_score[b, pos_item].item()),
+                    }
+                )
+
             if can_select:
                 selected_positions.append(pos_item)
                 selected[b, pos_item] = True
