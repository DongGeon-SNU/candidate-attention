+            decisive_normalized_score = None
             for sel_pos in selected_positions:
                 if dep_b[pos_item, sel_pos] > tau:
                     can_select = False
+                    decisive_blocker = sel_pos
+                    decisive_normalized_score = float(dep_b[pos_item, sel_pos].item())
                     break
 
+            # Observation is additive and never feeds a value back into the
+            # selection rule. It exposes the exact first blocker evaluated by
+            # this loop rather than a reconstructed post-hoc blocker set.
+            if decision_observer is not None:
+                decisive_raw_score = None
+                if decisive_blocker is not None and raw_dependency is not None:
