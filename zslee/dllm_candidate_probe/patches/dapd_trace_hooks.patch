@@ -300,13 +302,41 @@ def select_independent_set(
         sorted_positions = sorted_positions.tolist()
         selected_positions = []
 
-        for pos_item in sorted_positions:
+        for candidate_rank, pos_item in enumerate(sorted_positions):
             can_select = True
